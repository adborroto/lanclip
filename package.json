{
  "name": "lanclip",
  "version": "1.0.0",
  "description": "Self-hosted LAN clipboard with history, grep search, and curl support. No database — files only.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "nanoid": "^3.3.7"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "clipboard",
    "lan",
